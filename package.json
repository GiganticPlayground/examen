{
  "name": "examen",
  "version": "0.1.0",
  "description": "Declarative HTTP and CLI test runner",
  "type": "module",
  "bin": { "examen": "./dist/index.js" },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run gen-types && tsc",
    "gen-types": "tsx scripts/gen-types.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "execa": "^9.5.2",
    "seedrandom": "^3.0.5",
    "undici": "^6.21.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/seedrandom": "^3.0.8",
    "json-schema-to-typescript": "^15.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=20.0.0" }
}
